# Turso / libSQL (cloud SQLite). Copy to .env and fill in from https://app.turso.tech
# AWS endpoints must be used over HTTP — Django converts libsql:// to https://.
TURSO_DATABASE_URL=libsql://<db>-<org>.<region>.turso.io
TURSO_AUTH_TOKEN=

# Set to 0 to force the local db.sqlite3 file even if Turso creds are present.
USE_TURSO=1
